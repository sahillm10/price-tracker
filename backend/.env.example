PORT=3000

# Supabase -> Project Settings -> API.
# Use the SERVICE ROLE key (server-side only, NEVER expose to frontend).
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Shared secret for scheduled cron requests (Authorization: Bearer <secret> or x-cron-secret)
CRON_SECRET=your-cron-secret

# Frontend origin allowed by CORS (e.g. your Vercel URL or http://localhost:5173)
CORS_ORIGIN=http://localhost:5173

# Mock store target (defaults to INE store)
STORE_BASE_URL=https://demo.inelabteamdev.com

# Local inspection flags (0 or 1)
HEADED=0
CHAOS=0
